#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define KEYPAD 1
#define FN 2
#define MOD 3
#define HU_MAC 4
#define HU_WIN 5
#define WIN_DEFAULT 6

/ {
    behaviors {
      tog_on: toggle_layer_on_only {
          compatible = "zmk,behavior-toggle-layer";
          #binding-cells = <1>;
          display-name = "Layer On";
          toggle-mode = "on";
          locking;
      };

      tog_off: toggle_layer_off_only {
          compatible = "zmk,behavior-toggle-layer";
          #binding-cells = <1>;
          display-name = "Layer Off";
          toggle-mode = "off";
          locking;
      };

      select_profile_1: select_profile_1 {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          wait-ms = <20>;
          tap-ms = <20>;
          bindings =
              <&macro_tap &bt BT_SEL 0>,
              <&macro_tap &tog_off WIN_DEFAULT>;
          label = "SELECT_PROFILE_1";
          display-name = "Select Profile 1";
      };

      select_profile_2: select_profile_2 {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          wait-ms = <20>;
          tap-ms = <20>;
          bindings =
              <&macro_tap &bt BT_SEL 1>,
              <&macro_tap &tog_on WIN_DEFAULT>;
          label = "SELECT_PROFILE_2";
          display-name = "Select Profile 2";
      };

      select_profile_3: select_profile_3 {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          wait-ms = <20>;
          tap-ms = <20>;

          bindings =
              <&macro_tap &bt BT_SEL 2>,
              <&macro_tap &tog_off WIN_DEFAULT>;

          label = "SELECT_PROFILE_3";
          display-name = "Select Profile 3";
      };

      select_profile_4: select_profile_4 {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          wait-ms = <20>;
          tap-ms = <20>;

          bindings =
              <&macro_tap &bt BT_SEL 3>,
              <&macro_tap &tog_off WIN_DEFAULT>;

          label = "SELECT_PROFILE_4";
          display-name = "Select Profile 4";
      };

      select_profile_5: select_profile_5 {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          wait-ms = <20>;
          tap-ms = <20>;

          bindings =
              <&macro_tap &bt BT_SEL 4>,
              <&macro_tap &tog_off WIN_DEFAULT>;

          label = "SELECT_PROFILE_5";
          display-name = "Select Profile 5";
      };

      hu_lt: hu_layer_tap {
        compatible = "zmk,behavior-hold-tap";
        label = "HU_LAYER_TAP";
        #binding-cells = <2>;
        flavor = "hold-preferred";
        tapping-term-ms = <200>;
        bindings = <&mo>, <&kp>;
      };
      
      caps_tap: caps_tap {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <10>;
        tap-ms = <100>;
        bindings = <&macro_tap &kp CAPS>;
      };

      hu_caps: hu_caps {
        compatible = "zmk,behavior-hold-tap";
        label = "HU_CAPS";
        #binding-cells = <2>;
        flavor = "hold-preferred";
        tapping-term-ms = <200>;
        bindings = <&mo>, <&caps_tap>;
      };

      #include "macros.dtsi"
      #include "hu_mac.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1    &kp N2             &kp N3   &kp N4     &kp N5 &tog KEYPAD                                                                   &mo 3 &kp N6 &kp N7 &kp N8      &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W              &kp E    &kp R      &kp T  &none                                                                         &none &kp Y  &kp U  &kp I       &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S              &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI &kp RCTRL                         &none &kp H  &kp J  &kp K       &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X              &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                                  &kp N &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo FN    &kp GRAVE &hu_caps HU_MAC CAPS &kp LEFT &kp RIGHT                  &kp BSPC &kp DEL &kp END  &kp PG_DN &kp ENTER &kp SPACE                    &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo FN
      >;
    };
    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1     &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q      &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A      &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z      &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo FN     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0             &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo FN
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                              &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                                        &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock     &none        &none        &none        &none        &none        &none           &none &none &bt BT_CLR &none                          &stp STP_BAT           &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                           &none &none                                                            &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                            &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                         &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    hu_mac_layer {
      display-name = "Hu mac";
      bindings = <
        &trans &trans        &trans &trans       &trans &trans &trans                                                           &trans &trans &trans        &trans       &trans       &trans               &trans
        &trans &trans        &trans &mac_e_acute &trans &trans &trans                                                           &none  &trans &mac_u_acute  &mac_i_acute &mac_o_acute &mac_o_umlaut        &trans
        &trans &mac_a_acute  &trans &trans       &trans &trans &none           &trans &trans &trans &trans                      &none  &trans &trans        &trans       &trans       &mac_o_hungarumlaut  &mac_u_hungarumlaut
        &trans &trans        &trans &trans       &trans &trans                        &trans &trans                                    &trans &trans        &trans       &trans       &trans               &trans
        &trans &trans        &trans &trans       &trans                 &trans &trans &trans &trans &trans &trans                             &trans        &trans       &trans       &mac_u_umlaut        &trans
      >;
    };
    hu_win_layer {
      display-name = "Hu win";
      bindings = <
        &trans &trans        &trans &trans       &trans &trans &trans                                                           &trans &trans &trans        &trans       &trans       &trans               &trans
        &trans &trans        &trans &win_e_acute &trans &trans &trans                                                           &none  &trans &win_u_acute  &win_i_acute &win_o_acute &win_o_umlaut        &trans
        &trans &win_a_acute  &trans &trans       &trans &trans &none           &trans &trans &trans &trans                      &none  &trans &trans        &trans       &trans       &win_o_hungarumlaut  &win_u_hungarumlaut
        &trans &trans        &trans &trans       &trans &trans                        &trans &trans                                    &trans &trans        &trans       &trans       &trans               &trans
        &trans &trans        &trans &trans       &trans                 &trans &trans &trans &trans &trans &trans                             &trans        &trans       &trans       &mac_u_umlaut        &trans
      >;
    };
    win_default_layer {
      display-name = "Win Default layer";
      bindings = <
        &kp EQUAL &kp N1    &kp N2               &kp N3   &kp N4     &kp N5 &tog KEYPAD                                                                   &mo 3 &kp N6 &kp N7 &kp N8      &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W                &kp E    &kp R      &kp T  &none                                                                         &none &kp Y  &kp U  &kp I       &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S                &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI &kp RCTRL                         &none &kp H  &kp J  &kp K       &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X                &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                                  &kp N &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo FN    &kp GRAVE &hu_caps HU_WIN CAPS &kp LEFT &kp RIGHT                  &kp BSPC &kp DEL &kp END  &kp PG_DN &kp ENTER &kp SPACE                    &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo FN
      >;
    };

  };
};
