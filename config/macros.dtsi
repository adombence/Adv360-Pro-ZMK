  mac_a_acute_lower: macro_mac_a_acute_lower {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
      tap-ms = <20>;
      bindings =
          <&macro_press &kp LALT>,
          <&macro_tap &kp N0 &kp N0 &kp E &kp N1>,
          <&macro_release &kp LALT>;
      label = "MAC_A_ACUTE_LOWER";
      display-name = "MAC_A_ACUTE_LOWER";
  };

  mac_a_acute_upper: macro_mac_a_acute_upper {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <20>;
