          <&macro_press &kp LALT>,
          <&macro_tap &kp N0 &kp N0 &kp C &kp N1>,
          <&macro_release &kp LALT>;
      label = "MAC_A_ACUTE_UPPER";
      display-name = "MAC_A_ACUTE_UPPER";
  };

  mac_a_acute: mac_a_acute {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&mac_a_acute_lower>, <&mac_a_acute_upper>;
    mods = <(MOD_LSFT | MOD_RSFT)>;
  };

